#!/usr/bin/env bash
# netdiag — full network investigation for macOS.
# Runs a battery of checks, writes a timestamped report, attempts a root-cause
# diagnosis (wifi vs router vs ISP vs DNS), then launches gping against the
# discovered hops for live monitoring.
#
# Usage: netdiag [TARGET] [--quick] [--quiet] [--json] [--no-gping]
#                [--speed] [--no-speed] [--mtu-only] [--wifi-only]
#                [--dns-only] [--bufferbloat-only] [--ping-only]
#                [--baseline] [--no-baseline] [--log PATH] [-h|--help]
#
# This file is the orchestrator. Each section is implemented in lib/*.sh
# and called via its module function (foo_run). lib/common.sh holds the
# shared printing, diagnosis accumulator, timeout wrapper, and
# parallel-launch helpers.
#
# Argparse-set flags (NO_GPING, QUICK, …) and TIMESTAMP_ISO are read by
# the lib modules sourced later in this file. shellcheck can't follow the
# dynamic source loop so flag every assignment as cross-module-used.
# shellcheck disable=SC2034
# shellcheck source-path=SCRIPTDIR/..

# Require bash 5+. Re-exec under Homebrew bash if found, otherwise fail clean.
if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  for _cand in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [ -x "$_cand" ]; then
      exec "$_cand" "$0" "$@"
    fi
  done
  printf 'netdiag: requires bash 5+. Install with: brew install bash\n' >&2
  exit 3
fi

set -u

# ── Exit-code contract ─────────────────────────────────────────────────────
# 0 healthy · 1 warnings only · 2 ≥ 1 critical diagnosis · 3 script error.
#
# A `set -u` abort or any other unplanned exit leaves bash's own status
# (1 or 127 depending on the failure), which would masquerade as "warnings
# only" — a wrapper watching for exit 1 can't tell a degraded network from
# a broken script. Remap anything that didn't reach the end of the run to
# 3. Deliberate early exits (--help, the mode dispatchers, usage errors)
# set their own status and pass through untouched.
#
# The trap is not inherited by the ( … ) & subshells that launch_parallel
# and with_timeout fork, so it fires exactly once, in the orchestrator.
NETDIAG_COMPLETED=0
# Every line below is reached via `trap … EXIT` — an indirect dispatch that
# static analysis can't follow, so the body is not dead code.
# shellcheck disable=SC2317,SC2329
_netdiag_on_exit() {
  local rc=$?
  # Reap the progress spinner before anything else. It's a background
  # process, so on Ctrl-C or an early abort it would otherwise survive the
  # orchestrator and keep repainting a stale caption over the user's shell
  # prompt. Guarded because the trap is installed before lib/common.sh is
  # sourced, so an early failure can reach here with the function undefined.
  command -v progress_spin_stop >/dev/null 2>&1 && progress_spin_stop
  # Same guard, same reason: the parent-owned parallel scratch dir is
  # registered from lib/common.sh, which may not be sourced yet when an
  # early failure lands here. Without this sweep an aborted run leaks it.
  command -v _netdiag_tmp_cleanup >/dev/null 2>&1 && _netdiag_tmp_cleanup
  # The status is settled first and reported once, rather than exiting from
  # each branch, so the --progress stream's closing event can carry it. A
  # consumer renders every phase still unresolved at that point as "didn't
  # run"; without the event on the abort paths, a run killed with Ctrl-C
  # would spin in the UI forever.
  local final
  if [ "$NETDIAG_COMPLETED" -eq 1 ]; then
    final="$rc"
  elif [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ]; then
    final="$rc"
  elif [ "$rc" -gt 128 ]; then
    # 128+N means killed by signal N — Ctrl-C (130) or SIGTERM (143) is the
    # user stopping the run, not a defect. Same status, no alarming message.
    final=3
  else
    printf 'netdiag: aborted unexpectedly (status %d)\n' "$rc" >&2
    final=3
  fi
  command -v progress_run_done >/dev/null 2>&1 && progress_run_done "$final"
  exit "$final"
}
trap _netdiag_on_exit EXIT

# Resolve where we live so helpers/*.py and lib/*.sh can be found even when
# the script is symlinked into /usr/local/bin. macOS doesn't ship readlink -f.
_resolve_path() {
  local src="$1" target
  while [ -L "$src" ]; do
    target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(dirname "$src")/$target" ;;
    esac
  done
  printf '%s' "$src"
}
SCRIPT_PATH="$(_resolve_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HELPERS_DIR="${SCRIPT_DIR}/../helpers"
LIB_DIR="${SCRIPT_DIR}/../lib"

# lib/output.sh's build_json sets every other NETDIAG_* var it needs
# explicitly before invoking emit_json.py, so none of them can leak in
# from the caller's shell. run_id is the one exception by construction:
# the build that becomes the *stored* record (build_json_private) never
# sets NETDIAG_RUN_ID at all, deliberately, so that var's absence is what
# keeps a run_id key out of the bytes history.py hashes to produce that
# same id (see lib/output.sh's HISTORY_APPEND block). A stray
# NETDIAG_RUN_ID already exported in the invoking shell would slip through
# that gap unnoticed and plant a run_id key inside the stored record
# itself. Unset it before anything downstream can read it.
unset NETDIAG_RUN_ID

NETDIAG_VERSION="0.12.0"

_require_python3() {
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'netdiag: python3 is required but was not found on PATH\n' >&2
    return 1
  fi
}

# ── Argument parsing ───────────────────────────────────────────────────────
# gping starts off by default in v0.4+; the user either opts in with --gping
# or answers the post-report prompt. GPING_DECISION tracks whether the user
# made an explicit choice so we know whether to prompt.
NO_GPING=1
GPING_DECISION="unset"   # unset | opted_in | opted_out
QUICK=0
NO_BUFFERBLOAT=0
# The speed test runs by default from v0.6.0. "Is my internet slow?" is the
# single most common reason anyone runs this tool, and answering it with
# "not tested (run with --speed)" made the default report useless for the
# question it was opened to settle. --no-speed opts out; --quick skips it.
#
# SPEED_EXPLICIT records that the user actually typed --speed, which is the
# only way to keep the test under --quick. Without the distinction, "on by
# default" and "--quick skips it" contradict each other.
SPEED=1
SPEED_EXPLICIT=0
NO_SPEED=0
JSON_MODE=0
QUIET=0
# Default mode shows a compact "Report" card + "What we found" diagnoses.
# --expert keeps every detailed section visible (RSSI specifics, DNS
# per-resolver results, DHCP lease detail, full traceroute, etc.).
EXPERT=0
# Focused runs: "" (full battery), "mtu", "wifi", or "speed". Runs only the
# prerequisites for one section, then the Report card + diagnoses over
# whatever it produced.
FOCUS=""
# Which of the five shapes of run this is, recorded on the emitted and the
# stored record as `run_mode`. Without it every record looks alike: a
# --quick run and a full one are indistinguishable in history, so "1,986
# checks" on a network counted spot checks that measured almost nothing.
RUN_MODE=""
# --progress opens fd 3 and streams one JSON event per line as the run
# moves through its phases. Off by default and free when off: see the
# fd 3 section of lib/common.sh for why not stdout and why not stderr.
PROGRESS=0
# --redact masks the values that identify a person or a place (public IP,
# SSID, BSSID, IPv6 prefix, gateway MAC, city) on stdout and in --json,
# so a report can be pasted into a forum or ticket. The local log keeps
# full detail.
REDACT=0
LOG_OVERRIDE=""
BASELINE=1
NO_BASELINE=0
# Appending this run to ~/net-diag/baseline.jsonl and *comparing* it
# against the runs already there are two decisions, not one, and they were
# stuck together in NO_BASELINE. --quick has always appended without
# comparing; --speed-only needs the same, and could not have it — the
# FOCUS block sets NO_BASELINE=1, which suppressed the append too and left
# the store's sparsest metric (7 throughput samples in 1,986 runs) with no
# cheap way to grow.
HISTORY_APPEND=1
WATCH=0
WATCH_INTERVAL_S=300
SUMMARY=0
SUMMARY_WINDOW_HOURS=24
# --history emits the whole run store as normalized, network-grouped JSON
# for a GUI to chart. Distinct from --summary, which prints prose about one
# recent window. HISTORY_LIMIT caps it to the N most recent runs.
HISTORY=0
HISTORY_LIMIT=0
# --show opens one stored run by the id --history gave it: the whole
# record, plus how each of its metrics compares to every other run on the
# same network. A reading without that context ("3.7 ms") tells nobody
# whether their network is behaving.
SHOW=0
SHOW_ID=""
# --share renders one stored run — or one fed in on stdin — as plain
# text with identifying values masked, for pasting into a support chat.
# Distinct from --redact, which masks a run as it happens: the store
# deliberately keeps full detail (see lib/output.sh's REDACT save/restore),
# so sharing a *past* run has to redact at read time.
SHARE=0
SHARE_ID=""
# --monitor: the machine-readable sibling of --watch. Streams one compact
# JSON object per line until stopped. Three cadence tiers, each overridable
# so the GUI's Settings sliders have something to drive.
MONITOR=0
MONITOR_FAST_INTERVAL=10
MONITOR_DEGRADED_INTERVAL=5
MONITOR_MEDIUM_INTERVAL=60
MONITOR_SLOW_INTERVAL=300
MONITOR_COUNT=0          # >0: emit N samples then exit (tests, one-shots)
INSTALL_WATCHER=0
UNINSTALL_WATCHER=0
WATCH_CHILD=0
TARGET=""
_take_value=0
# Which --monitor-*-interval is awaiting its value, if any. A separate
# state from _take_value so `--log --monitor-count 5` can't silently
# consume the wrong argument.
_take_monitor=""
# Same reasoning for `--show <id>`: its own state, so a dangling --log
# never swallows the run id and vice versa.
_take_show=0
# Each --*-only flag below overwrites FOCUS with a bare assignment —
# stacking two used to silently keep only the last one and run it with no
# warning. This guard rejects the second one instead, matching the
# --mtu-only/--quick and --speed-only/--no-speed conflicts already handled
# further down in the flag-conflict validation block.
_set_focus() {
  if [ -n "$FOCUS" ]; then
    printf 'netdiag: --%s-only and --%s-only are mutually exclusive (see --help)\n' "$FOCUS" "$1" >&2
    exit 3
  fi
  FOCUS="$1"
}
while [ "$#" -gt 0 ]; do
  if [ "$_take_value" -eq 1 ]; then
    LOG_OVERRIDE="$1"; _take_value=0; shift; continue
  fi
  if [ "$_take_show" -eq 1 ]; then
    SHOW_ID="$1"; _take_show=0; shift; continue
  fi
  if [ -n "$_take_monitor" ]; then
    case "$_take_monitor" in
      FAST)     MONITOR_FAST_INTERVAL="$1" ;;
      DEGRADED) MONITOR_DEGRADED_INTERVAL="$1" ;;
      MEDIUM)   MONITOR_MEDIUM_INTERVAL="$1" ;;
      SLOW)     MONITOR_SLOW_INTERVAL="$1" ;;
      COUNT)    MONITOR_COUNT="$1" ;;
    esac
    _take_monitor=""; shift; continue
  fi
  case "$1" in
    --gping)          NO_GPING=0; GPING_DECISION="opted_in"  ;;
    --no-gping)       NO_GPING=1; GPING_DECISION="opted_out" ;;
    --quick)          QUICK=1 ;;
    --no-bufferbloat) NO_BUFFERBLOAT=1 ;;
    --speed)          SPEED=1; SPEED_EXPLICIT=1 ;;
    --no-speed)       NO_SPEED=1 ;;
    --json)           JSON_MODE=1 ;;
    --quiet)          QUIET=1 ;;
    --expert)         EXPERT=1 ;;
    --redact)         REDACT=1 ;;
    --mtu-only)       _set_focus mtu ;;
    --wifi-only)      _set_focus wifi ;;
    # --speed-only implies an explicit --speed: the whole point is "answer
    # this one question now", and leaving SPEED_EXPLICIT unset would let a
    # stray --quick silently turn the run into a no-op that still exited 0.
    --speed-only)     _set_focus speed; SPEED=1; SPEED_EXPLICIT=1 ;;
    --dns-only)       _set_focus dns ;;
    --bufferbloat-only) _set_focus bufferbloat ;;
    --ping-only)      _set_focus ping ;;
    --progress)       PROGRESS=1 ;;
    --log)            _take_value=1 ;;
    --log=*)          LOG_OVERRIDE="${1#--log=}" ;;
    --baseline)       BASELINE=1 ;;
    --no-baseline)    NO_BASELINE=1; HISTORY_APPEND=0 ;;
    --watch)          WATCH=1 ;;
    --watch=*)        WATCH=1; WATCH_INTERVAL_S="${1#--watch=}" ;;
    --summary)        SUMMARY=1 ;;
    --summary=*)      SUMMARY=1; SUMMARY_WINDOW_HOURS="${1#--summary=}" ;;
    --history)        HISTORY=1 ;;
    --history=*)      HISTORY=1; HISTORY_LIMIT="${1#--history=}" ;;
    --show)           SHOW=1; _take_show=1 ;;
    --show=*)         SHOW=1; SHOW_ID="${1#--show=}" ;;
    --share)          SHARE=1 ;;
    --share=*)        SHARE=1; SHARE_ID="${1#--share=}" ;;
    --monitor)        MONITOR=1 ;;
    --monitor-fast-interval)      _take_monitor=FAST ;;
    --monitor-fast-interval=*)    MONITOR_FAST_INTERVAL="${1#*=}" ;;
    --monitor-degraded-interval)  _take_monitor=DEGRADED ;;
    --monitor-degraded-interval=*) MONITOR_DEGRADED_INTERVAL="${1#*=}" ;;
    --monitor-medium-interval)    _take_monitor=MEDIUM ;;
    --monitor-medium-interval=*)  MONITOR_MEDIUM_INTERVAL="${1#*=}" ;;
    --monitor-slow-interval)      _take_monitor=SLOW ;;
    --monitor-slow-interval=*)    MONITOR_SLOW_INTERVAL="${1#*=}" ;;
    --monitor-count)              _take_monitor=COUNT ;;
    --monitor-count=*)            MONITOR_COUNT="${1#*=}" ;;
    --install-watcher)   INSTALL_WATCHER=1 ;;
    --uninstall-watcher) UNINSTALL_WATCHER=1 ;;
    --watch-child)       WATCH_CHILD=1 ;;
    --version)
      printf 'netdiag %s\n' "$NETDIAG_VERSION"
      exit 0 ;;
    --capabilities)
      _require_python3 || exit 3
      # A handshake, not a run: gather facts in bash, let python write the
      # JSON. Sourcing lib/speedtest.sh here is safe — the file is function
      # definitions only — and we need speedtest_flavor() to report which
      # speed-test implementation this install would actually use.
      # shellcheck source=lib/speedtest.sh
      . "$LIB_DIR/speedtest.sh"
      _cap_speed="$(speedtest_flavor)"
      case "${_cap_speed%%:*}" in
        ookla) NETDIAG_CAP_SPEEDTEST=ookla ;;
        cli)   NETDIAG_CAP_SPEEDTEST=cli ;;
        *)     NETDIAG_CAP_SPEEDTEST="" ;;
      esac
      NETDIAG_CAP_VERSION="$NETDIAG_VERSION"
      NETDIAG_CAP_BASH_VERSION="${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"
      # Nullable in the data model, but a machine with no python3 exits 3
      # below before emitting anything — the same silent assumption --json
      # and --history already make.
      NETDIAG_CAP_PYTHON3_VERSION="$(python3 -c 'import platform; print(platform.python_version())' 2>/dev/null || true)"
      NETDIAG_CAP_JQ=0;    command -v jq    >/dev/null 2>&1 && NETDIAG_CAP_JQ=1
      NETDIAG_CAP_MTR=0;   command -v mtr   >/dev/null 2>&1 && NETDIAG_CAP_MTR=1
      NETDIAG_CAP_GPING=0; command -v gping >/dev/null 2>&1 && NETDIAG_CAP_GPING=1
      export NETDIAG_CAP_VERSION NETDIAG_CAP_BASH_VERSION \
             NETDIAG_CAP_PYTHON3_VERSION NETDIAG_CAP_JQ NETDIAG_CAP_MTR \
             NETDIAG_CAP_GPING NETDIAG_CAP_SPEEDTEST
      python3 "$HELPERS_DIR/capabilities.py" || exit 3
      exit 0 ;;
    --rules-catalog)
      _require_python3 || exit 3
      # Same shape as --capabilities: a static handshake, not a run.
      # helpers/rules_catalog.py is pure module-level data — bash's only
      # job is naming the running version, the one fact python can't know
      # on its own.
      NETDIAG_RULES_VERSION="$NETDIAG_VERSION"
      export NETDIAG_RULES_VERSION
      python3 "$HELPERS_DIR/rules_catalog.py" || exit 3
      exit 0 ;;
    --signal-scale)
      _require_python3 || exit 3
      # Same shape as --rules-catalog: a static handshake, not a run. The
      # three RSSI cutoffs that define the Excellent/Good/Fair/Weak bands
      # already live in lib/thresholds.sh; they reach the helper through
      # the environment, the same handshake helpers/history.py's --show
      # uses for THRESH_COMPARE_* — a boundary that turns a dBm number
      # into a word belongs in exactly one place too.
      # shellcheck source=lib/thresholds.sh
      . "$LIB_DIR/thresholds.sh"
      export THRESH_WIFI_RSSI_EXCELLENT_DBM THRESH_WIFI_RSSI_G1_DBM \
             THRESH_WIFI_RSSI_WEAK_DBM
      python3 "$HELPERS_DIR/signal_scale.py" || exit 3
      exit 0 ;;
    -h|--help)
      cat <<'HELP'
netdiag — full network investigation for macOS.
Runs a battery of checks, writes a timestamped report, and attempts a
root-cause diagnosis (wifi vs router vs ISP vs DNS) written in plain
English. Optionally launches gping against the discovered hops for live
monitoring at the end.

Usage: netdiag [TARGET] [--quick] [--gping] [--no-bufferbloat] [--speed]
               [--json] [--quiet] [--expert] [--progress] [--log PATH]
               [--mtu-only | --wifi-only | --speed-only | --dns-only |
                --bufferbloat-only | --ping-only] [--share[=ID]]

Positional:
  TARGET            hostname/IP to add to ping, DNS, TCP reach, and a second
                    traceroute — useful for "this specific site is slow"

Common:
  --quick           skip slow checks (bufferbloat, per-hop loss, speed
                    test, internet packet-loss probe, MTU probe, WiFi
                    scan). Finishes in ~8 s on a healthy network.
  --no-speed        skip the speedtest — use on metered or slow links, and
                    to bring a full run back under ~30 s (to force it back
                    on under --quick, see --speed under Advanced)
  --expert          show every detailed measurement section (RSSI, full
                    DNS / TCP / traceroute / DHCP / per-hop loss). Default
                    output is a compact Report card + diagnoses only.
  --redact          mask identifying values (public IP, SSID, BSSID, IPv6
                    address, gateway MAC, city) on stdout and in --json so
                    the report is safe to paste into a forum or ticket.
                    The ISP name is deliberately kept — it names a
                    provider, which is what makes the report useful to
                    read. The log file on disk keeps full detail. Implies
                    compact output (--expert is ignored).

Sharing and output:
  --share[=ID|-]    print one run as plain text, no colours, identifying
                    values masked — the paste-ready form of a report.
                    Bare: the most recent stored run. =ID: that stored run
                    (ids come from --history). =-: read one run's JSON on
                    stdin.
  --json            emit one JSON object on stdout; no human-readable output
                    unless --log PATH is also passed
  --quiet           print only the diagnoses; suppress the Report card too
  --log PATH        write the human-readable log to PATH (default
                    ~/net-diag/<timestamp>.log)
  --progress        stream one JSON progress event per line on fd 3 (which
                    is pointed at stderr) as the run moves through its
                    phases: the plan, each phase starting and finishing,
                    and the speed test's own stages. stdout is untouched,
                    so --json --progress still emits exactly one object.
                    See docs/JSON-SCHEMA.md for the event reference.

Just one check:
  --mtu-only        run only the path-MTU probe (plus the interface and
                    public-reach checks it depends on)
  --wifi-only       run only the WiFi checks: link quality, neighbourhood
                    scan, and disconnect history
  --speed-only      run only the speed test (plus the interface, gateway
                    and public-reach checks it depends on). Recorded in
                    history as a speed-only run, so it adds a throughput
                    reading without counting as a check of your network's
                    health.
  --dns-only        run only the DNS checks and resolvers probe
  --bufferbloat-only run only the bufferbloat load test
  --ping-only       run only gateway and internet latency / packet loss probes

Modes (exit after running, don't run the normal check battery):
  --watch[=SEC]            re-run --quick netdiag every SEC seconds
                           (default 300). Ctrl-C to stop.
  --summary[=HOURS]        print an aggregate over the last HOURS of
                           ~/net-diag/baseline.jsonl (default 24).
  --history[=N]            emit the whole run store as one normalized JSON
                           object — networks grouped by identity, one
                           compact row per run — for charting. N caps it to
                           the N most recent runs. Reads the archive too.
  --show=ID                emit one stored run as JSON: the complete record
                           as it was written, where it sits in that
                           network's history, and how each of its metrics
                           compares to every other run on the same network.
                           IDs come from --history; a bare timestamp works
                           when it names exactly one run.
  --monitor                stream one compact JSON object per line, one per
                           sample, until stopped. The machine-readable
                           sibling of --watch (which re-runs --quick and
                           prints prose). Writes no log and no history.
                             --monitor-fast-interval SEC      (default 10)
                             --monitor-degraded-interval SEC  (default 5)
                             --monitor-medium-interval SEC    (default 60)
                             --monitor-slow-interval SEC      (default 300)
                             --monitor-count N   emit N samples then exit
  --install-watcher        install a launchd plist that runs netdiag
                           every 15 min in the background.
  --uninstall-watcher      remove the launchd plist.
  --version                print "netdiag VERSION" and exit.
  --capabilities           print one JSON object describing this install:
                           per-mode schema numbers, a feature list, and
                           which optional dependencies are on PATH — a
                           handshake for a GUI to check compatibility
                           before it relies on a feature.
  --rules-catalog          print one JSON object cataloguing every rule the
                           diagnosis engine and the monitor can emit: title,
                           category, descriptive severity, scope (scan /
                           monitor / both) and a plain-English blurb per
                           rule ID — the prose a GUI shows next to a rule
                           chip instead of reimplementing it in Swift. Also
                           carries a metrics glossary — see docs/JSON-SCHEMA.md.
  --signal-scale           print one JSON object with the four Wi-Fi signal
                           bands (Excellent/Good/Fair/Weak) this install's
                           thresholds define: a dBm boundary, a label, a
                           tone, and a plain sentence per band — the word a
                           GUI shows next to a raw RSSI reading instead of
                           inventing its own scale.

Advanced:
  --speed           run the speedtest even under --quick (it is already on
                    by default in a normal run; ~30 s and ~50 MB)
  --no-bufferbloat  skip the 100 MB / 10 s bufferbloat probe (saves data on
                    metered links)
  --gping           after the report, launch a live ping monitor on the
                    discovered hops (gping must be installed). Without
                    this flag you'll be prompted; default is no.
  --no-gping        skip the gping prompt entirely (used by scripts /
                    watchers; equivalent to answering "no" upfront)
  --baseline        compare this run against medians of the last 10 runs
                    in ~/net-diag/baseline.jsonl (default on)
  --no-baseline     skip the baseline comparison and don't append to history
HELP
      exit 0 ;;
    -*)
      printf 'netdiag: unknown flag: %s (see --help)\n' "$1" >&2; exit 3 ;;
    *)
      if [ -n "$TARGET" ]; then
        printf 'netdiag: only one TARGET allowed (got: %s and %s)\n' "$TARGET" "$1" >&2
        exit 3
      fi
      TARGET="$1" ;;
  esac
  shift
done
if [ "$_take_value" -eq 1 ]; then
  printf 'netdiag: --log expects a path\n' >&2; exit 3
fi
if [ -n "$_take_monitor" ]; then
  printf 'netdiag: --monitor interval flag expects a value\n' >&2; exit 3
fi
if [ "$_take_show" -eq 1 ]; then
  printf 'netdiag: --show expects a run id (see --history)\n' >&2; exit 3
fi
# Section bodies stream out as each module runs — before later modules have
# discovered everything that needs masking. Rather than emit a partially
# redacted transcript (worse than none: it looks safe), --redact forces the
# compact Report card, which prints after every value is known.
if [ "$REDACT" -eq 1 ]; then
  EXPERT=0
fi
if [ -n "$FOCUS" ] && [ "$WATCH" -eq 0 ] && [ "$SUMMARY" -eq 0 ]; then
  case "$FOCUS" in
    mtu)  [ "$QUICK" -eq 0 ] || { printf 'netdiag: --mtu-only and --quick conflict (--quick skips the MTU probe)\n' >&2; exit 3; } ;;
    bufferbloat) [ "$QUICK" -eq 0 ] || { printf 'netdiag: --bufferbloat-only and --quick conflict (--quick skips the bufferbloat probe)\n' >&2; exit 3; } ;;
    ping) [ "$QUICK" -eq 0 ] || { printf 'netdiag: --ping-only and --quick conflict (--quick skips the internet loss probe)\n' >&2; exit 3; } ;;
    # Same shape as the conflict above: a run whose only job is the speed
    # test, told not to run the speed test, would do nothing at all and
    # still exit 0 — a success status over an empty report.
    speed) [ "$NO_SPEED" -eq 0 ] || { printf 'netdiag: --speed-only and --no-speed conflict (nothing would be measured)\n' >&2; exit 3; } ;;
  esac
fi

# The mode name is the one recorded on the run and the one the progress
# plan is drawn from, so it is derived once, here, rather than re-derived
# by each consumer from the flags it happens to remember to check.
if [ -n "$FOCUS" ]; then
  RUN_MODE="${FOCUS}-only"
elif [ "$QUICK" -eq 1 ]; then
  RUN_MODE="quick"
else
  RUN_MODE="full"
fi

# ── Progress channel (fd 3) ────────────────────────────────────────────────
# Opened before anything can emit — every mode below inherits it, including
# the ones that exit early. An emitter writing to an fd that was never
# opened prints "Bad file descriptor" on stderr for every event, which
# would break the promise that --progress off leaves stderr untouched.
#
# /dev/null rather than leaving it closed for the same reason. If stderr
# itself is closed (`netdiag --progress 2>&-`) the dup below fails, later
# writes fail silently, and the run continues: progress must never be able
# to fail a check.
if [ "$PROGRESS" -eq 1 ]; then
  exec 3>&2
else
  exec 3>/dev/null
fi

LOG_DIR="$HOME/net-diag"

# Reject malformed mode values before dispatching to a loop or helper. A
# bad --watch interval otherwise makes sleep return immediately and spins a
# destructive history-writing loop; a bad summary window otherwise reaches
# argparse with exit 2, which is reserved for a critical diagnosis.
if [ "$WATCH" -eq 1 ]; then
  case "$WATCH_INTERVAL_S" in
    ''|*[!0-9]*|0)
      printf 'netdiag: --watch expects a whole number of seconds >= 1 (got: %s)\n' "$WATCH_INTERVAL_S" >&2
      exit 3 ;;
  esac
fi
if [ "$SUMMARY" -eq 1 ]; then
  case "$SUMMARY_WINDOW_HOURS" in
    ''|*[!0-9]*|0)
      printf 'netdiag: --summary expects a whole number of hours >= 1 (got: %s)\n' "$SUMMARY_WINDOW_HOURS" >&2
      exit 3 ;;
  esac
fi

# All report and history modes delegate JSON shaping to Python. Fail once at
# the boundary with a usage/tooling error instead of silently producing a
# partial report when a minimal installation has no python3.
_require_python3 || exit 3

# ── Mode dispatch (exit after handling) ────────────────────────────────────
if [ "$INSTALL_WATCHER" -eq 1 ]; then
  # shellcheck source=lib/launchd.sh
  . "$LIB_DIR/launchd.sh"
  install_watcher_run
fi
if [ "$UNINSTALL_WATCHER" -eq 1 ]; then
  # shellcheck source=lib/launchd.sh
  . "$LIB_DIR/launchd.sh"
  uninstall_watcher_run
fi
if [ "$SUMMARY" -eq 1 ]; then
  # --summary now judges each metric line, so it needs the cutoffs, and
  # they reach Python through the environment exactly as --history's and
  # --show's do. The helper refuses to start without them rather than
  # carrying a default — see summary.py's _require_threshold.
  # shellcheck source=lib/thresholds.sh
  . "$LIB_DIR/thresholds.sh"
  export LOSS_WARN_PCT LOSS_CRIT_PCT THRESH_BUFFERBLOAT_B_MS \
         THRESH_BUFFERBLOAT_C_MS THRESH_WIFI_RSSI_WEAK_DBM \
         THRESH_WIFI_RSSI_G1_DBM THRESH_MTU_STANDARD THRESH_MTU_CRIT \
         THRESH_NTP_DRIFT_WARN_S THRESH_NTP_DRIFT_CRIT_S
  python3 "$HELPERS_DIR/summary.py" \
    --history "$LOG_DIR/baseline.jsonl" \
    --window "$SUMMARY_WINDOW_HOURS" || exit 3
  exit 0
fi

if [ "$HISTORY" -eq 1 ]; then
  # A non-numeric --history=X is a usage error, not something to pass to
  # python and let argparse turn into an exit 2 — that status is reserved
  # for a real diagnosis.
  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) printf 'netdiag: --history expects a run count (got: %s)\n' "$HISTORY_LIMIT" >&2; exit 3 ;;
  esac
  # Every network row now carries metric_stats — median/p10/p90 over the
  # same population --show already judges runs against — so the plain
  # listing needs THRESH_COMPARE_* too, the same cutoffs and the same
  # refusal to carry a default. See lib/thresholds.sh and the --show
  # block below.
  # shellcheck source=lib/thresholds.sh
  . "$LIB_DIR/thresholds.sh"
  export THRESH_COMPARE_MIN_SAMPLES THRESH_COMPARE_TAIL_PCTL
  python3 "$HELPERS_DIR/history.py" \
    --history "$LOG_DIR/baseline.jsonl" \
    --limit "$HISTORY_LIMIT" || exit 3
  exit 0
fi
if [ "$SHOW" -eq 1 ]; then
  # An empty id is a usage error like any other: exit 3, never 2, so a
  # wrapper can still tell "you typed it wrong" from "your network is
  # broken". Whether the id names a real run is history.py's question.
  if [ -z "$SHOW_ID" ]; then
    printf 'netdiag: --show expects a run id (see --history)\n' >&2; exit 3
  fi
  # This is the one mode where history.py judges rather than reports, so
  # it is the one mode that needs the cutoffs. They go through the
  # environment like every other helper's input, and the helper refuses to
  # start without them — a Python default would be a second home for a
  # number that has exactly one.
  # shellcheck source=lib/thresholds.sh
  . "$LIB_DIR/thresholds.sh"
  export THRESH_COMPARE_MIN_SAMPLES THRESH_COMPARE_TAIL_PCTL NETDIAG_VERSION
  # An unknown id, a missing store, or a helper that crashed are all "3":
  # python's own argparse exits 2, which would read as a critical
  # diagnosis to anything watching the status.
  python3 "$HELPERS_DIR/history.py" \
    --history "$LOG_DIR/baseline.jsonl" \
    --show "$SHOW_ID" || exit 3
  exit 0
fi
if [ "$SHARE" -eq 1 ]; then
  # stdin: the app's path. It already holds the run's JSON and needs no
  # store lookup, so a run that finished two seconds ago shares exactly
  # like one from last week.
  if [ "$SHARE_ID" = "-" ]; then
    python3 "$HELPERS_DIR/share.py" || exit 3
    exit 0
  fi
  # Sourced before the id lookup, not after: history.py refuses to start
  # without THRESH_COMPARE_*, including for a plain --history listing,
  # because every network row carries metric_stats.
  # shellcheck source=lib/thresholds.sh
  . "$LIB_DIR/thresholds.sh"
  export THRESH_COMPARE_MIN_SAMPLES THRESH_COMPARE_TAIL_PCTL NETDIAG_VERSION
  _share_id="$SHARE_ID"
  if [ -z "$_share_id" ]; then
    # Bare --share: the newest run in the store. --history's `runs` is a
    # flat top-level array, each row keyed `id` and `ts` — not nested
    # under networks[], and not run_id/timestamp.
    _share_id="$(python3 "$HELPERS_DIR/history.py" \
        --history "$LOG_DIR/baseline.jsonl" 2>/dev/null \
      | python3 -c 'import json, sys
try:
    runs = json.load(sys.stdin).get("runs") or []
except Exception:
    runs = []
runs.sort(key=lambda r: r.get("ts") or "")
print(runs[-1].get("id", "") if runs else "")' 2>/dev/null)"
    if [ -z "$_share_id" ]; then
      printf 'netdiag: no stored run to share yet — run a check first\n' >&2
      exit 3
    fi
  fi
  # --show returns {schema, version, id, run, context, comparison}; `run`
  # is the complete record as it was written.
  #
  # This is a 3-stage pipeline, and bin/netdiag does not set `pipefail`
  # (deliberately — see the header comment on the EXIT trap): in
  # `a | b | c`, `$?` is `c`'s status alone, so a mid-pipeline failure
  # (a bogus id makes history.py's --show exit 3 with nothing on stdout)
  # can be masked if a later stage happens to exit 0 anyway. Scoping
  # `set -o pipefail` to a subshell around just this pipeline makes the
  # subshell's own exit status the *worst* of the three, without changing
  # pipefail behavior anywhere else in the script.
  if ! (
    set -o pipefail
    python3 "$HELPERS_DIR/history.py" \
        --history "$LOG_DIR/baseline.jsonl" \
        --show "$_share_id" 2>/dev/null \
      | python3 -c 'import json, sys
doc = json.load(sys.stdin)
json.dump(doc["run"], sys.stdout)' 2>/dev/null \
      | python3 "$HELPERS_DIR/share.py" 2>/dev/null
  ); then
    # share.py's own "not valid JSON" message would otherwise also print
    # here, on empty input cascading down from the failed lookup above —
    # true, but confusing next to the reason actually printed below.
    printf 'netdiag: no stored run to share (id: %s)\n' "$_share_id" >&2
    exit 3
  fi
  exit 0
fi
if [ "$WATCH" -eq 1 ]; then
  # shellcheck source=lib/watch.sh
  . "$LIB_DIR/watch.sh"
  watch_run
fi
if [ "$MONITOR" -eq 1 ]; then
  # Every interval is a whole number of seconds; anything else would reach
  # $(( )) as a syntax error mid-stream, hours into a run. Fail at startup.
  for _iv in MONITOR_FAST_INTERVAL MONITOR_DEGRADED_INTERVAL \
             MONITOR_MEDIUM_INTERVAL MONITOR_SLOW_INTERVAL MONITOR_COUNT; do
    case "${!_iv}" in
      ''|*[!0-9]*)
        printf 'netdiag: %s expects a whole number of seconds (got: %s)\n' \
          "$_iv" "${!_iv}" >&2; exit 3 ;;
    esac
  done
  for _iv in MONITOR_FAST_INTERVAL MONITOR_DEGRADED_INTERVAL \
             MONITOR_MEDIUM_INTERVAL MONITOR_SLOW_INTERVAL; do
    if [ "${!_iv}" -lt 1 ]; then
      printf 'netdiag: %s must be at least 1 second\n' "$_iv" >&2; exit 3
    fi
  done
  # The monitor writes only to stdout: no log file, no baseline append,
  # nothing under ~/net-diag. It is a read-only observer, and a process
  # that runs for days must not accumulate anything.
  LOG=/dev/null
  # shellcheck source=lib/thresholds.sh
  . "$LIB_DIR/thresholds.sh"
  # shellcheck source=lib/common.sh
  . "$LIB_DIR/common.sh"
  # shellcheck source=lib/globals.sh
  . "$LIB_DIR/globals.sh"
  # netid.sh so identity is computed by the same code a scan uses — a live
  # sample and a stored run have to agree on network.id or the app cannot
  # join one to the other.
  # shellcheck source=lib/netid.sh
  . "$LIB_DIR/netid.sh"
  # shellcheck source=lib/vpn.sh
  . "$LIB_DIR/vpn.sh"
  # shellcheck source=lib/monitor.sh
  . "$LIB_DIR/monitor.sh"
  monitor_run
  NETDIAG_COMPLETED=1
  exit 0
fi

# ── Log file setup ─────────────────────────────────────────────────────────
STAMP="$(date +%Y-%m-%d-%H%M%S)"
TIMESTAMP_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -n "$LOG_OVERRIDE" ]; then
  LOG="$LOG_OVERRIDE"
  mkdir -p "$(dirname "$LOG")"
elif [ "$JSON_MODE" -eq 1 ]; then
  # --json without --log: route the log to /dev/null so say() still works.
  LOG="/dev/null"
else
  mkdir -p "$LOG_DIR"
  LOG="$LOG_DIR/$STAMP.log"
fi

# ── Source common infrastructure, globals, and every section module ────────
# Explicit per-source comments give shellcheck a follow path; the dynamic
# loop below sources the rest with SC1090 disabled since the path is
# variable.
# thresholds.sh first: it declares the policy constants (loss floors, RSSI
# cutoffs, drift limits) that common.sh's grade_bufferbloat and every rule
# in diagnosis.sh read. It deliberately depends on nothing, so lib/monitor.sh
# can source it alone and judge the same conditions with the same numbers.
# shellcheck source=lib/thresholds.sh
. "$LIB_DIR/thresholds.sh"
# shellcheck source=lib/common.sh
. "$LIB_DIR/common.sh"
# shellcheck source=lib/globals.sh
. "$LIB_DIR/globals.sh"
for mod in iface vpn wifi wifi_scan wifi_disconnect dhcp arp gateway public \
           bufferbloat mtu dns ipv6 tcp_reach speedtest ntp traceroute mtr \
           wan internet_ping hosts netid path headline diagnosis output gping; do
  # shellcheck disable=SC1090
  . "$LIB_DIR/$mod.sh"
done

# ── Header + orchestration ─────────────────────────────────────────────────
# tell() always prints (except under --json) — the header is meant to
# survive --quiet and default-compact mode.
tell "${C_BOLD}netdiag${C_RESET}  ${C_DIM}$STAMP${C_RESET}"
tell "${C_DIM}log: $LOG${C_RESET}"

# ── Focused runs (--*-only) ────────────────────────────────────────────────
# Run one section plus the checks it depends on, then the Report card and
# diagnoses over whatever that produced. gping and the baseline diff are
# both suppressed: a partial run isn't comparable to a full one, and
# recording it would poison the history the full runs are measured against.
if [ -n "$FOCUS" ]; then
  NO_GPING=1
  NO_BASELINE=1
  # NO_BASELINE above suppresses the *comparison* only: a partial run isn't
  # comparable to a full one. Whether it is also unrecordable is a separate
  # question, and run_mode is what changed the answer for --speed-only — a
  # record tagged speed-only can no longer be mistaken for a check of the
  # network's health, so appending it can't poison the medians full runs
  # are measured against, and its throughput reading is exactly the number
  # the store has least of. --mtu-only and --wifi-only stay unrecorded,
  # which is the behaviour their existing records were written under.
  case "$FOCUS" in
    speed) : ;;
    *)     HISTORY_APPEND=0 ;;
  esac
  progress_plan "$RUN_MODE"
  case "$FOCUS" in
    mtu)
      run_timed iface  iface_run
      run_timed netid  netid_run   # best-effort: no GW_MAC, falls back to gateway IP
      run_timed public public_run  # mtu_run gates on PUBLIC_OK
      run_timed mtu    mtu_run
      ;;
    wifi)
      run_timed iface iface_run
      run_timed wifi  wifi_run     # sets IS_WIFI, which the two scans below gate on
      run_timed netid netid_run
      launch_parallel wifi_scan       wifi_scan_run
      launch_parallel wifi_disconnect wifi_disconnect_run
      progress_spin_start "Scanning WiFi neighbourhood"
      collect_parallel
      progress_spin_stop
      ;;
    speed)
      run_timed iface   iface_run
      # Everything between iface and speedtest is here for the *record*,
      # not the report, and costs about 4 s against a 30 s test.
      #
      # gateway_run refreshes the ARP entry arp_run then reads GW_MAC out
      # of, and GW_MAC is the join key that lands this run in the same
      # history group as the full runs on this network. Without it netid
      # falls back to the gateway IP and the throughput sample this mode
      # exists to contribute is invisible to the network it was measured
      # on. wifi_run is here for the other half of that identity: netid
      # reads IS_WIFI, so leaving it out recorded a WiFi network as
      # "wired via 192.168.15.1" — measured, on this machine, before it
      # was added.
      run_timed gateway gateway_run
      run_timed arp     arp_run
      run_timed wifi    wifi_run
      run_timed netid   netid_run
      run_timed public  public_run   # speedtest_run gates on PUBLIC_OK
      run_timed speedtest speedtest_run
      ;;
    dns)
      run_timed iface iface_run
      run_timed dhcp dhcp_run
      run_timed netid netid_run
      run_timed dns dns_run
      ;;
    bufferbloat)
      run_timed iface        iface_run
      run_timed gateway      gateway_run
      run_timed arp          arp_run
      run_timed wifi         wifi_run
      run_timed netid        netid_run
      run_timed public       public_run
      run_timed bufferbloat  bufferbloat_run
      ;;
    ping)
      run_timed iface          iface_run
      run_timed gateway        gateway_run
      run_timed arp            arp_run
      run_timed wifi           wifi_run
      run_timed netid          netid_run
      run_timed internet_ping  internet_ping_run
      ;;
  esac
  headline_run
  diagnosis_run
  output_run
  NETDIAG_COMPLETED=1
  exit "$MAX_SEVERITY"
fi

# Each phase is wrapped in run_timed so the run can report where its
# wall-clock actually went — see the `timings` object in --json output and
# the Timing section under --expert. The same two wrappers feed the
# --progress event stream, so the order below is the order the plan
# declares in lib/common.sh and a phase added here must be added there too
# (tests/test_progress.bats fails the build otherwise).
progress_plan "$RUN_MODE"

run_timed iface      iface_run
run_timed vpn        vpn_run
run_timed wifi       wifi_run
run_timed gateway    gateway_run
run_timed arp        arp_run   # L2: belongs with the gateway/L2 layer
run_timed netid      netid_run # needs GW_MAC from arp_run, SSID from wifi_run
# The identity tripwire's first reading, taken once the interface and
# WiFi state are known. Cheap (~15 ms) and deliberately not a second
# netid_run, which would cost tens of seconds. [DQ-1]
NETID_FP_START="$(netid_fingerprint_live)"

run_timed dhcp       dhcp_run  # L3 control plane, between L2 and public reach
run_timed public     public_run

# Parallel batch: lightweight, independent checks. Bounded by the slowest
# in the batch (DNS or WiFi disconnect, ~3 s) instead of their sum (~15 s).
launch_parallel dns             dns_run
launch_parallel ipv6            ipv6_run
launch_parallel tcp_reach       tcp_reach_run
launch_parallel ntp             ntp_run
launch_parallel hosts           hosts_run
launch_parallel wifi_scan       wifi_scan_run
launch_parallel wifi_disconnect wifi_disconnect_run
launch_parallel wan_lb          wan_load_balancing_run
launch_parallel wan_upnp        wan_upnp_run
launch_parallel path            path_run
progress_spin_start "Running parallel checks (DNS, IPv6, TCP, NTP, hosts, WiFi, dual-WAN, UPnP)"
run_timed parallel_batch collect_parallel
progress_spin_stop

# Internet-side loss/latency runs serially, on a deliberately quiet link.
# It was in the batch above until v0.6.0, where it began feeding the L1
# critical: measured while DNS, TCP, NTP, the WiFi scan and two WAN probes
# all competed for the same interface, it reported 30% loss on a link that
# an isolated probe showed to be clean. A number that decides a critical
# diagnosis has to be measured without the tool's own traffic in the way.
# Placed before bufferbloat, which saturates the link on purpose.
progress_spin_start "Measuring internet latency and packet loss"
run_timed internet_ping internet_ping_run
progress_spin_stop

run_timed bufferbloat bufferbloat_run
run_timed mtu         mtu_run
run_timed traceroute  traceroute_run
run_timed nat         wan_double_nat_run  # pure parse over TRACE_LINES
run_timed mtr         mtr_run

# The second reading, before anything judges the numbers. Everything
# between here and NETID_FP_START was measured on the network this
# compares against — if it changed, the measurements straddle two. [DQ-1]
NETID_FP_END="$(netid_fingerprint_live)"
netid_fingerprint_changed "$NETID_FP_START" "$NETID_FP_END" \
  && NETWORK_CHANGED_MID_RUN=1

headline_run     # one-line punchline of everything above
diagnosis_run

# The speed test runs LAST, after the Report card and the diagnoses have
# already been printed. It is by far the most expensive phase (~58 s of a
# ~95 s run with speedtest-cli), and every check that matters for a
# diagnosis has completed by now — nothing in diagnosis_run reads
# SPEEDTEST_*, only the JSON emitter does. Running it before the report
# meant the user stared at a spinner for a minute before learning anything
# about their network, including in the case where the answer was "your
# router is dropping packets" and they'd have acted on it immediately.
#
# It still cannot be parallelised: it deliberately saturates the link, so
# it would corrupt every latency, loss, and bufferbloat number if it
# overlapped them. Last is the only safe place for it.
run_timed speedtest   speedtest_run

# output_run comes after, so --json and the log still carry the speed
# figures — only the human-readable ordering changed.
output_run

# gping prompt: if the user didn't pass --gping or --no-gping and we're
# in an interactive terminal, ask before launching the live monitor.
# Default-no on 5-second timeout. Skipped under quiet / json / watch.
if [ "$GPING_DECISION" = "unset" ] \
   && [ "$JSON_MODE" -eq 0 ] && [ "$QUIET" -eq 0 ] \
   && [ "$WATCH_CHILD" -eq 0 ] && [ "$WATCH" -eq 0 ] \
   && [ -t 0 ] && [ -t 1 ] \
   && command -v gping >/dev/null 2>&1 \
   && [ -n "$GATEWAY" ]; then
  printf '\n%sLaunch live ping monitor on the discovered hops? [y/N]%s ' \
    "${C_DIM}" "${C_RESET}" >&2
  _gping_reply=""
  # shellcheck disable=SC2162  # read -r is set; -t handles the no-input case.
  read -t 5 -r _gping_reply || true
  case "$_gping_reply" in
    [yY]|[yY][eE][sS]) NO_GPING=0 ;;
    *)                 NO_GPING=1; printf '\n' >&2 ;;
  esac
fi
gping_run

# Spec exit codes: 0 healthy · 1 warn · 2 critical · 3 script error.
# NETDIAG_COMPLETED tells the EXIT trap this status is a real verdict and
# not an abort to be remapped to 3.
NETDIAG_COMPLETED=1
exit "$MAX_SEVERITY"
