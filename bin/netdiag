#!/usr/bin/env bash
# netdiag — full network investigation for macOS.
# Runs a battery of checks, writes a timestamped report, attempts a root-cause
# diagnosis (wifi vs router vs ISP vs DNS), then launches gping against the
# discovered hops for live monitoring.
#
# Usage: netdiag [TARGET] [--quick] [--quiet] [--json] [--no-gping]
#                [--speed] [--no-speed] [--mtu-only] [--wifi-only]
#                [--baseline] [--no-baseline] [--log PATH] [-h|--help]
#
# This file is the orchestrator. Each section is implemented in lib/*.sh
# and called via its module function (foo_run). lib/common.sh holds the
# shared printing, diagnosis accumulator, timeout wrapper, and
# parallel-launch helpers.
#
# Argparse-set flags (NO_GPING, QUICK, …) and TIMESTAMP_ISO are read by
# the lib modules sourced later in this file. shellcheck can't follow the
# dynamic source loop so flag every assignment as cross-module-used.
# shellcheck disable=SC2034
# shellcheck source-path=SCRIPTDIR/..

# Require bash 5+. Re-exec under Homebrew bash if found, otherwise fail clean.
if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  for _cand in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [ -x "$_cand" ]; then
      exec "$_cand" "$0" "$@"
    fi
  done
  printf 'netdiag: requires bash 5+. Install with: brew install bash\n' >&2
  exit 3
fi

set -u

# ── Exit-code contract ─────────────────────────────────────────────────────
# 0 healthy · 1 warnings only · 2 ≥ 1 critical diagnosis · 3 script error.
#
# A `set -u` abort or any other unplanned exit leaves bash's own status
# (1 or 127 depending on the failure), which would masquerade as "warnings
# only" — a wrapper watching for exit 1 can't tell a degraded network from
# a broken script. Remap anything that didn't reach the end of the run to
# 3. Deliberate early exits (--help, the mode dispatchers, usage errors)
# set their own status and pass through untouched.
#
# The trap is not inherited by the ( … ) & subshells that launch_parallel
# and with_timeout fork, so it fires exactly once, in the orchestrator.
NETDIAG_COMPLETED=0
# Every line below is reached via `trap … EXIT` — an indirect dispatch that
# static analysis can't follow, so the body is not dead code.
# shellcheck disable=SC2317
_netdiag_on_exit() {
  local rc=$?
  [ "$NETDIAG_COMPLETED" -eq 1 ] && exit "$rc"
  [ "$rc" -eq 0 ] && exit 0
  [ "$rc" -eq 3 ] && exit 3
  # 128+N means killed by signal N — Ctrl-C (130) or SIGTERM (143) is the
  # user stopping the run, not a defect. Same status, no alarming message.
  [ "$rc" -gt 128 ] && exit 3
  printf 'netdiag: aborted unexpectedly (status %d)\n' "$rc" >&2
  exit 3
}
trap _netdiag_on_exit EXIT

# Resolve where we live so helpers/*.py and lib/*.sh can be found even when
# the script is symlinked into /usr/local/bin. macOS doesn't ship readlink -f.
_resolve_path() {
  local src="$1" target
  while [ -L "$src" ]; do
    target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(dirname "$src")/$target" ;;
    esac
  done
  printf '%s' "$src"
}
SCRIPT_PATH="$(_resolve_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HELPERS_DIR="${SCRIPT_DIR}/../helpers"
LIB_DIR="${SCRIPT_DIR}/../lib"

NETDIAG_VERSION="0.4.1"

# ── Argument parsing ───────────────────────────────────────────────────────
# gping starts off by default in v0.4+; the user either opts in with --gping
# or answers the post-report prompt. GPING_DECISION tracks whether the user
# made an explicit choice so we know whether to prompt.
NO_GPING=1
GPING_DECISION="unset"   # unset | opted_in | opted_out
QUICK=0
NO_BUFFERBLOAT=0
SPEED=0
NO_SPEED=0
JSON_MODE=0
QUIET=0
# Default mode shows a compact "Report" card + "What we found" diagnoses.
# --expert keeps every detailed section visible (RSSI specifics, DNS
# per-resolver results, DHCP lease detail, full traceroute, etc.).
EXPERT=0
# Focused runs: "" (full battery), "mtu", or "wifi". Runs only the
# prerequisites for one section, then the Report card + diagnoses over
# whatever it produced.
FOCUS=""
LOG_OVERRIDE=""
BASELINE=1
NO_BASELINE=0
WATCH=0
WATCH_INTERVAL_S=300
SUMMARY=0
SUMMARY_WINDOW_HOURS=24
INSTALL_WATCHER=0
UNINSTALL_WATCHER=0
WATCH_CHILD=0
TARGET=""
_take_value=0
while [ "$#" -gt 0 ]; do
  if [ "$_take_value" -eq 1 ]; then
    LOG_OVERRIDE="$1"; _take_value=0; shift; continue
  fi
  case "$1" in
    --gping)          NO_GPING=0; GPING_DECISION="opted_in"  ;;
    --no-gping)       NO_GPING=1; GPING_DECISION="opted_out" ;;
    --quick)          QUICK=1 ;;
    --no-bufferbloat) NO_BUFFERBLOAT=1 ;;
    --speed)          SPEED=1 ;;
    --no-speed)       NO_SPEED=1 ;;
    --json)           JSON_MODE=1 ;;
    --quiet)          QUIET=1 ;;
    --expert)         EXPERT=1 ;;
    --mtu-only)       FOCUS="mtu" ;;
    --wifi-only)      FOCUS="wifi" ;;
    --log)            _take_value=1 ;;
    --log=*)          LOG_OVERRIDE="${1#--log=}" ;;
    --baseline)       BASELINE=1 ;;
    --no-baseline)    NO_BASELINE=1 ;;
    --watch)          WATCH=1 ;;
    --watch=*)        WATCH=1; WATCH_INTERVAL_S="${1#--watch=}" ;;
    --summary)        SUMMARY=1 ;;
    --summary=*)      SUMMARY=1; SUMMARY_WINDOW_HOURS="${1#--summary=}" ;;
    --install-watcher)   INSTALL_WATCHER=1 ;;
    --uninstall-watcher) UNINSTALL_WATCHER=1 ;;
    --watch-child)       WATCH_CHILD=1 ;;
    -h|--help)
      cat <<'HELP'
netdiag — full network investigation for macOS.
Runs a battery of checks, writes a timestamped report, and attempts a
root-cause diagnosis (wifi vs router vs ISP vs DNS) written in plain
English. Optionally launches gping against the discovered hops for live
monitoring at the end.

Usage: netdiag [TARGET] [--quick] [--gping] [--no-bufferbloat] [--speed]
               [--json] [--quiet] [--expert] [--log PATH]
               [--mtu-only | --wifi-only]

Positional:
  TARGET            hostname/IP to add to ping, DNS, TCP reach, and a second
                    traceroute — useful for "this specific site is slow"

Flags:
  --quick           skip slow checks (bufferbloat, per-hop loss, speed test,
                    WiFi scan)
  --gping           after the report, launch a live ping monitor on the
                    discovered hops (gping must be installed). Without
                    this flag you'll be prompted; default is no.
  --no-gping        skip the gping prompt entirely (used by scripts /
                    watchers; equivalent to answering "no" upfront)
  --no-bufferbloat  skip the 100 MB / 10 s bufferbloat probe (saves data on
                    metered links)
  --speed           run a speedtest (down/up/latency/jitter); ~30 s and ~50 MB
  --no-speed        forbid the speedtest even if --speed was passed
  --json            emit one JSON object on stdout; no human-readable output
                    unless --log PATH is also passed
  --quiet           print only the diagnoses; suppress the Report card too
  --expert          show every detailed measurement section (RSSI, full
                    DNS / TCP / traceroute / DHCP / per-hop loss). Default
                    output is a compact Report card + diagnoses only.
  --mtu-only        run only the path-MTU probe (plus the interface and
                    public-reach checks it depends on)
  --wifi-only       run only the WiFi checks: link quality, neighbourhood
                    scan, and disconnect history
  --log PATH        write the human-readable log to PATH (default
                    ~/net-diag/<timestamp>.log)
  --baseline        compare this run against medians of the last 10 runs
                    in ~/net-diag/baseline.jsonl (default on)
  --no-baseline     skip the baseline comparison and don't append to history

Modes (exit after running, don't run the normal check battery):
  --watch[=SEC]            re-run --quick netdiag every SEC seconds
                           (default 300). Ctrl-C to stop.
  --summary[=HOURS]        print an aggregate over the last HOURS of
                           ~/net-diag/baseline.jsonl (default 24).
  --install-watcher        install a launchd plist that runs netdiag
                           every 15 min in the background.
  --uninstall-watcher      remove the launchd plist.
HELP
      exit 0 ;;
    -*)
      printf 'netdiag: unknown flag: %s (see --help)\n' "$1" >&2; exit 3 ;;
    *)
      if [ -n "$TARGET" ]; then
        printf 'netdiag: only one TARGET allowed (got: %s and %s)\n' "$TARGET" "$1" >&2
        exit 3
      fi
      TARGET="$1" ;;
  esac
  shift
done
if [ "$_take_value" -eq 1 ]; then
  printf 'netdiag: --log expects a path\n' >&2; exit 3
fi
if [ -n "$FOCUS" ] && [ "$WATCH" -eq 0 ] && [ "$SUMMARY" -eq 0 ]; then
  case "$FOCUS" in
    mtu)  [ "$QUICK" -eq 0 ] || { printf 'netdiag: --mtu-only and --quick conflict (--quick skips the MTU probe)\n' >&2; exit 3; } ;;
  esac
fi

LOG_DIR="$HOME/net-diag"

# ── Mode dispatch (exit after handling) ────────────────────────────────────
if [ "$INSTALL_WATCHER" -eq 1 ]; then
  # shellcheck source=lib/launchd.sh
  . "$LIB_DIR/launchd.sh"
  install_watcher_run
fi
if [ "$UNINSTALL_WATCHER" -eq 1 ]; then
  # shellcheck source=lib/launchd.sh
  . "$LIB_DIR/launchd.sh"
  uninstall_watcher_run
fi
if [ "$SUMMARY" -eq 1 ]; then
  python3 "$HELPERS_DIR/summary.py" \
    --history "$LOG_DIR/baseline.jsonl" \
    --window "$SUMMARY_WINDOW_HOURS"
  exit 0
fi
if [ "$WATCH" -eq 1 ]; then
  # shellcheck source=lib/watch.sh
  . "$LIB_DIR/watch.sh"
  watch_run
fi

# ── Log file setup ─────────────────────────────────────────────────────────
STAMP="$(date +%Y-%m-%d-%H%M%S)"
TIMESTAMP_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -n "$LOG_OVERRIDE" ]; then
  LOG="$LOG_OVERRIDE"
  mkdir -p "$(dirname "$LOG")"
elif [ "$JSON_MODE" -eq 1 ]; then
  # --json without --log: route the log to /dev/null so say() still works.
  LOG="/dev/null"
else
  mkdir -p "$LOG_DIR"
  LOG="$LOG_DIR/$STAMP.log"
fi

# ── Source common infrastructure, globals, and every section module ────────
# Explicit per-source comments give shellcheck a follow path; the dynamic
# loop below sources the rest with SC1090 disabled since the path is
# variable.
# shellcheck source=lib/common.sh
. "$LIB_DIR/common.sh"
# shellcheck source=lib/globals.sh
. "$LIB_DIR/globals.sh"
for mod in iface vpn wifi wifi_scan wifi_disconnect dhcp arp gateway public \
           bufferbloat mtu dns ipv6 tcp_reach speedtest ntp traceroute mtr \
           wan internet_ping hosts headline diagnosis output gping; do
  # shellcheck disable=SC1090
  . "$LIB_DIR/$mod.sh"
done

# ── Header + orchestration ─────────────────────────────────────────────────
# tell() always prints (except under --json) — the header is meant to
# survive --quiet and default-compact mode.
tell "${C_BOLD}netdiag${C_RESET}  ${C_DIM}$STAMP${C_RESET}"
tell "${C_DIM}log: $LOG${C_RESET}"

# ── Focused runs (--mtu-only / --wifi-only) ────────────────────────────────
# Run one section plus the checks it depends on, then the Report card and
# diagnoses over whatever that produced. gping and the baseline diff are
# both suppressed: a partial run isn't comparable to a full one, and
# recording it would poison the history the full runs are measured against.
if [ -n "$FOCUS" ]; then
  NO_GPING=1
  NO_BASELINE=1
  case "$FOCUS" in
    mtu)
      iface_run
      public_run     # mtu_run gates on PUBLIC_OK
      mtu_run
      ;;
    wifi)
      iface_run
      wifi_run       # sets IS_WIFI, which the two scans below gate on
      launch_parallel wifi_scan       wifi_scan_run
      launch_parallel wifi_disconnect wifi_disconnect_run
      progress_spin_start "Scanning WiFi neighbourhood"
      collect_parallel
      progress_spin_stop
      ;;
  esac
  headline_run
  diagnosis_run
  output_run
  NETDIAG_COMPLETED=1
  exit "$MAX_SEVERITY"
fi

iface_run
vpn_run
wifi_run
gateway_run
arp_run     # L2: belongs with the gateway/L2 layer (post-gateway per spec)
dhcp_run    # L3 control plane — sits between L2 and public reach
public_run

# Parallel batch: lightweight, independent checks. Bounded by the slowest
# in the batch (DNS or WiFi disconnect, ~3 s) instead of their sum (~15 s).
launch_parallel dns             dns_run
launch_parallel ipv6            ipv6_run
launch_parallel tcp_reach       tcp_reach_run
launch_parallel ntp             ntp_run
launch_parallel internet_ping   internet_ping_run
launch_parallel hosts           hosts_run
launch_parallel wifi_scan       wifi_scan_run
launch_parallel wifi_disconnect wifi_disconnect_run
launch_parallel wan_lb          wan_load_balancing_run
launch_parallel wan_upnp        wan_upnp_run
progress_spin_start "Running parallel checks (DNS, IPv6, TCP, NTP, latency, hosts, WiFi, dual-WAN, UPnP)"
collect_parallel
progress_spin_stop

bufferbloat_run
mtu_run
traceroute_run
wan_double_nat_run   # pure parse over TRACE_LINES; runs after traceroute
mtr_run
speedtest_run
headline_run     # one-line punchline of everything above
diagnosis_run
output_run

# gping prompt: if the user didn't pass --gping or --no-gping and we're
# in an interactive terminal, ask before launching the live monitor.
# Default-no on 5-second timeout. Skipped under quiet / json / watch.
if [ "$GPING_DECISION" = "unset" ] \
   && [ "$JSON_MODE" -eq 0 ] && [ "$QUIET" -eq 0 ] \
   && [ "$WATCH_CHILD" -eq 0 ] && [ "$WATCH" -eq 0 ] \
   && [ -t 0 ] && [ -t 1 ] \
   && command -v gping >/dev/null 2>&1 \
   && [ -n "$GATEWAY" ]; then
  printf '\n%sLaunch live ping monitor on the discovered hops? [y/N]%s ' \
    "${C_DIM}" "${C_RESET}" >&2
  _gping_reply=""
  # shellcheck disable=SC2162  # read -r is set; -t handles the no-input case.
  read -t 5 -r _gping_reply || true
  case "$_gping_reply" in
    [yY]|[yY][eE][sS]) NO_GPING=0 ;;
    *)                 NO_GPING=1; printf '\n' >&2 ;;
  esac
fi
gping_run

# Spec exit codes: 0 healthy · 1 warn · 2 critical · 3 script error.
# NETDIAG_COMPLETED tells the EXIT trap this status is a real verdict and
# not an abort to be remapped to 3.
NETDIAG_COMPLETED=1
exit "$MAX_SEVERITY"
